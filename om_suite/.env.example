# Copy to .env for local use. On Render these are set in the dashboard (see render.yaml).
APP_ENV=development
APP_NAME=OM Suite
SECRET_KEY=change-me-long-random-string

# Signups with these e-mails become approved admins immediately (comma separated).
# If empty, the very first signup becomes admin.
ADMIN_EMAILS=siddharthsingh9522@gmail.com

# --- Firebase Firestore (persistent user store). Leave empty to use local SQLite (dev only). ---
FIREBASE_PROJECT_ID=ptp-report
# Paste the whole service-account JSON on ONE line, or point to a file:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIRESTORE_PREFIX=omsuite_

# URL of the separate gr_auto_modification_system deployment (opens from a dashboard tile)
GR_AUTO_URL=

# OmInsights (Metabase) - each user saves their own login in Settings; these are server-wide.
OMINSIGHTS_URL=https://ominsights.omlogistics.co.in
OMINSIGHTS_ALLOWED_CARDS=546,967
# Optional: key for encrypting saved OmInsights passwords (defaults to one derived from SECRET_KEY)
CREDENTIAL_KEY=

# Optional: Gemini key for the AI Chatbot's wording/fallback answers (numbers always come from the data)
GEMINI_ADMIN_API_KEY=

# --- Thunderbird bridge / Mail Center ---
# Public https URL of this app (goes into the extension connection code). Empty = taken from the request.
PUBLIC_URL=
# Secret used to derive every user's bridge token (defaults to SECRET_KEY). Changing it invalidates all tokens.
BRIDGE_MASTER=
# Defaults prefilled in Settings -> Mail sending (SMTP). Each user saves their own login there.
SMTP_DEFAULT_HOST=mail.omlogistics.co.in
SMTP_DEFAULT_PORT=587
SMTP_DEFAULT_SECURITY=starttls

# --- Internal OM portals scraped by Branch Finder / Customer Search / OM Automation ---
# (these must be reachable from the server - see README)
BRANCH_URL=http://scmomsanchar.omlogistics.co.in/oracle/query/branch.php
CUSTOMER_PORTAL_USER_ID=39942
CN_API_URL=https://load.omone.in/utility-service/api/cn-status/{}
# GST Query drives a real headless Chrome (needs the Docker image). Each session uses ~300 MB RAM.
GST_MAX_SESSIONS=1
GST_IDLE_SECONDS=600

# --- Optional tuning (defaults are fine) ---
# SESSION_DAYS=14            # how long a login lasts
# MAX_UPLOAD_MB=50           # largest accepted upload
# DISPLAY_TZ_OFFSET_MIN=330  # time zone shown in admin/audit pages (330 = IST)
# USER_CACHE_TTL=10          # seconds a block/approve may take to reach a logged-in user
# OMINSIGHTS_TIMEOUT=600     # seconds for a big OmInsights export
# DATA_DIR=./data            # users (SQLite fallback), workspaces, masters, queue, jobs
# TRUST_PROXY=1              # on by default in production (Render's proxy headers)
# CHROME_BIN / CHROMEDRIVER_PATH are set inside the Docker image for GST Query
