{
  "manifest_version": 2,
  "name": "OM Suite Mail Bridge",
  "version": "2.0.0",
  "description": "Sends OM Suite mail (Mail Center, Bill Mail) through your own Thunderbird account and matches historical Sent mails for recipients.",
  "browser_specific_settings": {
    "gecko": {
      "id": "om-suite-bridge@omlogistics.local",
      "strict_min_version": "102.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "compose",
    "compose.send",
    "storage",
    "alarms",
    "notifications",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon-48.png",
    "64": "icon.png"
  },
  "browser_action": {
    "default_title": "OM Suite Mail Bridge",
    "default_popup": "popup.html",
    "default_icon": "icon-48.png"
  },
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}